NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=false
DOMAIN=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
DATA_PATH=./data
APP_MEMORY=4g
APP_CPUS=2
APP_VERSION=local
DATA_DIR=./data
DATABASE_FILE=./data/metadata.sqlite
ARTIFACT_DIR=./data/artifacts
WORKSPACE_DIR=./data/workspaces
ANDROID_HOME=
GRADLE_COMMAND=gradle
GRADLE_USER_HOME=./data/gradle-home
BUILD_HOME_DIR=./data/build-home
GRADLE_JVM_ARGS=-Xmx2g
MAX_ACTIVE_BUILDS_PER_CLIENT=3
MAX_STORAGE_MB_PER_CLIENT=500
MAX_UPLOAD_MB=50
MAX_EXTRACTED_MB=150
MAX_ZIP_FILES=2000
MAX_ZIP_DEPTH=12
MAX_HTML_MB=5
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=25000000
QUEUE_LIMIT=20
WORKER_CONCURRENCY=1
BUILD_TIMEOUT_SECONDS=900
ARTIFACT_RETENTION_HOURS=72
ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
API_KEY=
