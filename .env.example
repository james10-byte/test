# Environment variables for Web-to-APK Builder

# Port to bind Flask application (default: 5000)
PORT=5000

# Optional: Path to JDK 17 (auto-detected if not set)
JAVA_HOME=C:\Users\msall\.jdks\corretto-17.0.20.1

# Optional: Path to Android SDK (auto-detected if not set)
ANDROID_HOME=C:\Users\msall\AppData\Local\Android\Sdk

# Flask debug mode
FLASK_DEBUG=0

# Release Keystore Configuration (Optional - auto-generated if omitted)
# RELEASE_KEYSTORE_PATH=
# RELEASE_KEY_ALIAS=webtoapk
# RELEASE_KEYSTORE_PASSWORD=
# RELEASE_KEY_PASSWORD=
